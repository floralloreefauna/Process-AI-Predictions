/**
 * Example: Processing face detection results
 * Shows how to filter and analyze detected faces
 */
function demonstrateFaceProcessing() {
  console.log('\n=== Face Processing Example ===\n');

  const sampleResult = createSampleRecognitionResult();
  const originalFaces = sampleResult.faces || [];

  console.log(`👥 Original face count: ${originalFaces.length}`);
  originalFaces.forEach((face, index) => {
    const size = face.boundingBox.width * face.boundingBox.height;
    console.log(`  Face ${index + 1}: confidence ${(face.confidence * 100).toFixed(1)}%, size ${(size * 100).toFixed(1)}%`);
