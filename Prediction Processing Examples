  // Process faces with custom options
  const processedFaces = processFaceResults(originalFaces, {
    minConfidence: 0.8,
    minFaceSize: 0.02, // 2% of image
    maxFaces: 5
  });

  console.log(`\n✅ Processed face count: ${processedFaces.data.length}`);
  processedFaces.data.forEach((face, index) => {
    const size = face.boundingBox.width * face.boundingBox.height;
    console.log(`  Face ${index + 1}: confidence ${(face.confidence * 100).toFixed(1)}%, size ${(size * 100).toFixed(1)}%`);
  });

  if (processedFaces.warnings.length > 0) {
    console.log('\n⚠️  Face processing warnings:');
    processedFaces.warnings.forEach(warning => console.log(`  - ${warning}`));
  }

  return processedFaces;
}

