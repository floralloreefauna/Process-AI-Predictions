/**
 * Example: Basic processing of recognition results
 * Shows how to clean and validate AI predictions
 */
function demonstrateBasicProcessing() {
  console.log('=== Basic Processing Example ===\n');

  const sampleResult = createSampleRecognitionResult();
  console.log(`📊 Original result has ${sampleResult.objects.length} objects`);

  // Process with default options
  const processed = processRecognitionResult(sampleResult);
  
  console.log(`✅ Processed result has ${processed.data.objects.length} objects`);
  console.log(`📈 Overall confidence: ${(processed.data.confidence * 100).toFixed(1)}%`);
  console.log(`⏱️  Processing time: ${processed.statistics.processingTime}ms`);
  console.log(`🔍 Filtered out: ${processed.statistics.filteredCount} objects`);
  
  if (processed.warnings.length > 0) {
    console.log('\n⚠️  Warnings:');
    processed.warnings.forEach(warning => console.log(`  - ${warning}`));
  }

  return processed;
}

// ============================================================================
// EXAMPLE 2: ADVANCED FILTERING
// ============================================================================

/**
 * Example: Advanced filtering with specific criteria
 * Shows how to target specific object types or regions
 */
function demonstrateAdvancedFiltering() {
  console.log('\n=== Advanced Filtering Example ===\n');

  const sampleResult = createSampleRecognitionResult();
  
  // Filter for people only
  const peopleFilter: FilterCriteria = {
    includeLabels: ['person'],
    minSize: 0.05, // At least 5% of image
    maxSize: 0.8   // No more than 80% of image
  };

  const peopleOnly = filterObjects(sampleResult.objects, peopleFilter);
  
  console.log(`👥 Found ${peopleOnly.data.length} people after filtering`);
  console.log(`📊 Filtering statistics:`);
  console.log(`  - Input: ${peopleOnly.statistics.inputCount} objects`);
  console.log(`  - Output: ${peopleOnly.statistics.outputCount} objects`);
  console.log(`  - Filtered: ${peopleOnly.statistics.filteredCount} objects`);
  console.log(`  - Average confidence: ${(peopleOnly.statistics.averageConfidence * 100).toFixed(1)}%`);

  // Filter for vehicles in specific region
  const vehicleRegionFilter: FilterCriteria = {
    includeLabels: ['car', 'truck', 'motorcycle'],
    regionsOfInterest: [
      { x: 0.4, y: 0.3, width: 0.6, height: 0.5 } // Right side of image
    ]
  };

  const vehiclesInRegion = filterObjects(sampleResult.objects, vehicleRegionFilter);
  console.log(`🚗 Found ${vehiclesInRegion.data.length} vehicles in region of interest`);

  return { peopleOnly, vehiclesInRegion };
}

// ============================================================================
// EXAMPLE 3: AGGREGATION ANALYSIS
// ============================================================================

/**
 * Example: Aggregating objects by type
 * Shows how to get summary statistics for different object categories
 */
function demonstrateAggregation() {
  console.log('\n=== Aggregation Analysis Example ===\n');

  const sampleResult = createSampleRecognitionResult();
  const aggregations = aggregateObjectsByLabel(sampleResult.objects);

  console.log('📊 Object Aggregations:');
  Object.entries(aggregations.data).forEach(([label, agg]) => {
    console.log(`\n${label.toUpperCase()}:`);
    console.log(`  Count: ${agg.count}`);
    console.log(`  Average confidence: ${(agg.averageConfidence * 100).toFixed(1)}%`);
    console.log(`  Confidence range: ${(agg.minConfidence * 100).toFixed(1)}% - ${(agg.maxConfidence * 100).toFixed(1)}%`);
    console.log(`  Average size: ${(agg.averageSize * 100).toFixed(1)}% of image`);
  });

  // Find the most common object type
  const mostCommon = Object.entries(aggregations.data)
    .sort(([, a], [, b]) => b.count - a.count)[0];
  
  console.log(`\n🏆 Most common object: ${mostCommon[0]} (${mostCommon[1].count} instances)`);

  return aggregations;
}

// ============================================================================
// EXAMPLE 4: COORDINATE TRANSFORMATION
// ============================================================================

/**
 * Example: Transforming coordinates between different systems
 * Shows how to convert between relative and absolute coordinates
 */
function demonstrateCoordinateTransformation() {
  console.log('\n=== Coordinate Transformation Example ===\n');

  const sampleResult = createSampleRecognitionResult();
  const originalObjects = sampleResult.objects.slice(0, 2); // Take first 2 objects

  console.log('📍 Original relative coordinates:');
  originalObjects.forEach((obj, index) => {
    console.log(`  Object ${index + 1} (${obj.label}):`);
    console.log(`    Position: (${(obj.boundingBox.x * 100).toFixed(1)}%, ${(obj.boundingBox.y * 100).toFixed(1)}%)`);
    console.log(`    Size: ${(obj.boundingBox.width * 100).toFixed(1)}% × ${(obj.boundingBox.height * 100).toFixed(1)}%`);
  });

  // Transform to absolute coordinates
  const targetDimensions = { width: 1920, height: 1080 };
  const absoluteCoords = transformBoundingBoxes(originalObjects, targetDimensions, true);

  console.log('\n📍 Absolute coordinates (1920×1080):');
  absoluteCoords.data.forEach((obj, index) => {
    console.log(`  Object ${index + 1} (${obj.label}):`);
    console.log(`    Position: (${obj.boundingBox.x.toFixed(0)}, ${obj.boundingBox.y.toFixed(0)})`);
    console.log(`    Size: ${obj.boundingBox.width.toFixed(0)} × ${obj.boundingBox.height.toFixed(0)}`);
  });

  // Transform back to relative coordinates
  const backToRelative = transformBoundingBoxes(absoluteCoords.data, targetDimensions, false);

  console.log('\n📍 Back to relative coordinates:');
  backToRelative.data.forEach((obj, index) => {
    console.log(`  Object ${index + 1} (${obj.label}):`);
    console.log(`    Position: (${(obj.boundingBox.x * 100).toFixed(1)}%, ${(obj.boundingBox.y * 100).toFixed(1)}%)`);
    console.log(`    Size: ${(obj.boundingBox.width * 100).toFixed(1)}% × ${(obj.boundingBox.height * 100).toFixed(1)}%`);
  });

  return { absoluteCoords, backToRelative };
}

