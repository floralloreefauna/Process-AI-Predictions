/**
 * Example: Performance analysis of processing functions
 * Shows how to measure and compare processing efficiency
 */
function demonstratePerformanceAnalysis() {
  console.log('\n=== Performance Analysis ===\n');

  const sampleResult = createSampleRecognitionResult();
  const iterations = 1000;

  // Test basic processing performance
  const basicStart = Date.now();
  for (let i = 0; i < iterations; i++) {
    processRecognitionResult(sampleResult);
  }
  const basicTime = Date.now() - basicStart;

  // Test filtering performance
  const filterStart = Date.now();
  for (let i = 0; i < iterations; i++) {
    filterObjects(sampleResult.objects, { includeLabels: ['person'] });
  }
  const filterTime = Date.now() - filterStart;

  // Test aggregation performance
  const aggStart = Date.now();
  for (let i = 0; i < iterations; i++) {
    aggregateObjectsByLabel(sampleResult.objects);
  }
  const aggTime = Date.now() - aggStart;

  console.log(`📈 Performance Results (${iterations} iterations each):`);
  console.log(`  - Basic processing: ${basicTime}ms (${(basicTime / iterations).toFixed(2)}ms per operation)`);
  console.log(`  - Object filtering: ${filterTime}ms (${(filterTime / iterations).toFixed(2)}ms per operation)`);
  console.log(`  - Object aggregation: ${aggTime}ms (${(aggTime / iterations).toFixed(2)}ms per operation)`);

  // Calculate throughput
  const basicThroughput = (iterations / basicTime) * 1000;
  const filterThroughput = (iterations / filterTime) * 1000;
  const aggThroughput = (iterations / aggTime) * 1000;

  console.log(`\n🚀 Throughput (operations per second):`);
  console.log(`  - Basic processing: ${basicThroughput.toFixed(0)} ops/sec`);
  console.log(`  - Object filtering: ${filterThroughput.toFixed(0)} ops/sec`);
  console.log(`  - Object aggregation: ${aggThroughput.toFixed(0)} ops/sec`);

  return { basicTime, filterTime, aggTime };
}

