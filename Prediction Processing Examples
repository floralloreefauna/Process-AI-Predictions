/**
 * Example: Complex processing workflow
 * Shows how to combine multiple processing steps
 */
function demonstrateComplexWorkflow() {
  console.log('\n=== Complex Processing Workflow ===\n');

  const sampleResult = createSampleRecognitionResult();
  
  // Step 1: Basic processing
  console.log('🔄 Step 1: Basic processing...');
  const step1 = processRecognitionResult(sampleResult, {
    minConfidence: 0.6,
    sortByConfidence: true,
    mergeOverlapping: true,
    overlapThreshold: 0.3,
    maxResults: 10
  });

  // Step 2: Filter for people and vehicles
  console.log('🔄 Step 2: Filtering for people and vehicles...');
  const peopleAndVehicles = filterObjects(step1.data.objects, {
    includeLabels: ['person', 'car', 'truck', 'motorcycle']
  });

  // Step 3: Aggregate by type
  console.log('🔄 Step 3: Aggregating by object type...');
  const aggregations = aggregateObjectsByLabel(peopleAndVehicles.data);

  // Step 4: Process text
  console.log('🔄 Step 4: Processing extracted text...');
  const processedText = processTextResults(sampleResult.text || []);

  // Step 5: Process faces
  console.log('🔄 Step 5: Processing detected faces...');
  const processedFaces = processFaceResults(sampleResult.faces || []);

  // Summary
  console.log('\n📊 Workflow Summary:');
  console.log(`  - Objects processed: ${step1.statistics.inputCount} → ${step1.statistics.outputCount}`);
  console.log(`  - People/vehicles found: ${peopleAndVehicles.data.length}`);
  console.log(`  - Object types: ${Object.keys(aggregations.data).length}`);
  console.log(`  - Text elements: ${processedText.data.length}`);
  console.log(`  - Faces detected: ${processedFaces.data.length}`);
  console.log(`  - Total processing time: ${step1.statistics.processingTime + peopleAndVehicles.statistics.processingTime + aggregations.statistics.processingTime + processedText.statistics.processingTime + processedFaces.statistics.processingTime}ms`);

  return {
    step1,
    peopleAndVehicles,
    aggregations,
    processedText,
    processedFaces
  };
}

