// SPECIALIZED PROCESSING FUNCTIONS
// ============================================================================

/**
 * Process text extraction results
 * Filters and cleans up OCR results
 */
function processTextResults(
  textResults: ExtractedText[],
  options: {
    minConfidence: number;
    minLength: number;
    removeDuplicates: boolean;
  } = {
    minConfidence: 0.7,
    minLength: 2,
    removeDuplicates: true
  }
): ProcessingResult<ExtractedText[]> {
  const startTime = Date.now();
  const warnings: string[] = [];
  const originalCount = textResults.length;

  let processed = textResults.filter(text => {
    if (text.confidence < options.minConfidence) {
      warnings.push(`Filtered out low-confidence text: "${text.text}" (${text.confidence})`);
      return false;
    }
    if (text.text.length < options.minLength) {
      warnings.push(`Filtered out short text: "${text.text}"`);
      return false;
    }
    return true;
  });

  // Remove duplicates
  if (options.removeDuplicates) {
    const seen = new Set<string>();
    processed = processed.filter(text => {
      const normalized = text.text.toLowerCase().trim();
      if (seen.has(normalized)) {
        warnings.push(`Removed duplicate text: "${text.text}"`);
        return false;
      }
      seen.add(normalized);
      return true;
    });
  }

  const processingTime = Date.now() - startTime;
  const statistics: ProcessingStatistics = {
    inputCount: originalCount,
    outputCount: processed.length,
    filteredCount: originalCount - processed.length,
    processingTime,
    averageConfidence: processed.length > 0 
      ? processed.reduce((sum, t) => sum + t.confidence, 0) / processed.length 
      : 0
  };

  return {
    data: processed,
    statistics,
    warnings
  };
}

/**
 * Process face detection results
 * Applies face-specific filtering and analysis
 */
function processFaceResults(
  faceResults: DetectedFace[],
  options: {
    minConfidence: number;
    minFaceSize: number;
    maxFaces: number;
  } = {
    minConfidence: 0.8,
    minFaceSize: 0.01, // 1% of image
    maxFaces: 10
  }
): ProcessingResult<DetectedFace[]> {
  const startTime = Date.now();
  const warnings: string[] = [];
  const originalCount = faceResults.length;

  let processed = faceResults.filter(face => {
    if (face.confidence < options.minConfidence) {
      warnings.push(`Filtered out low-confidence face (${face.confidence})`);
      return false;
    }

    const faceSize = face.boundingBox.width * face.boundingBox.height;
    if (faceSize < options.minFaceSize) {
      warnings.push(`Filtered out small face (size: ${faceSize.toFixed(3)})`);
      return false;
    }

    return true;
  });

  // Sort by confidence and limit
  processed.sort((a, b) => b.confidence - a.confidence);
  if (processed.length > options.maxFaces) {
    processed = processed.slice(0, options.maxFaces);
    warnings.push(`Limited to ${options.maxFaces} faces`);
  }

  const processingTime = Date.now() - startTime;
  const statistics: ProcessingStatistics = {
    inputCount: originalCount,
    outputCount: processed.length,
    filteredCount: originalCount - processed.length,
    processingTime,
    averageConfidence: processed.length > 0 
      ? processed.reduce((sum, f) => sum + f.confidence, 0) / processed.length 
      : 0
  };

  return {
    data: processed,
    statistics,
    warnings
  };
}

// ============================================================================
// TYPE DEFINITIONS FOR AGGREGATION RESULTS
// ============================================================================

/**
 * Aggregated statistics for objects of the same label
 */
interface ObjectAggregation {
  /** Object label */
  label: string;
  /** Number of instances */
  count: number;
  /** Sum of all confidences */
  totalConfidence: number;
  /** Average confidence */
  averageConfidence: number;
  /** Minimum confidence */
  minConfidence: number;
  /** Maximum confidence */
  maxConfidence: number;
  /** Average size (relative to image) */
  averageSize: number;
  /** Sum of all sizes */
  totalSize: number;
  /** Individual instances */
  instances: ObjectInstance[];
}

/**
 * Individual object instance with metadata
 */
interface ObjectInstance {
  /** Unique identifier */
  id: string;
  /** Confidence score */
  confidence: number;
  /** Bounding box */
  boundingBox: BoundingBox;
  /** Size relative to image */
  size: number;
}

